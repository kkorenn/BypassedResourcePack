<Project>

  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)/build/obj/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>BypassedResourcePack</AssemblyName>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <BuildRoot>$(MSBuildProjectDirectory)/build</BuildRoot>
    <OutputPath>$(BuildRoot)/bin/$(Configuration)/$(TargetFramework)/</OutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/</IntermediateOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <NoWarn>CS1701;CS1702</NoWarn>
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>

    <_Home Condition="'$(HOME)'!=''">$(HOME)</_Home>
    <_Home Condition="'$(_Home)'=='' And '$(USERPROFILE)'!=''">$(USERPROFILE)</_Home>

    <Game Condition="'$(Game)'=='' And '$(ADOFAI)'!=''">$(ADOFAI)</Game>
    <Game Condition="'$(Game)'=='' And Exists('$(_Home)/Library/Application Support/Steam/steamapps/common/A Dance of Fire and Ice')">$(_Home)/Library/Application Support/Steam/steamapps/common/A Dance of Fire and Ice</Game>
    <Game Condition="'$(Game)'=='' And Exists('$(_Home)/.steam/steam/steamapps/common/A Dance of Fire and Ice')">$(_Home)/.steam/steam/steamapps/common/A Dance of Fire and Ice</Game>
    <Game Condition="'$(Game)'=='' And Exists('$(_Home)/.local/share/Steam/steamapps/common/A Dance of Fire and Ice')">$(_Home)/.local/share/Steam/steamapps/common/A Dance of Fire and Ice</Game>
    <Game Condition="'$(Game)'=='' And Exists('C:\Program Files (x86)\Steam\steamapps\common\A Dance of Fire and Ice')">C:\Program Files (x86)\Steam\steamapps\common\A Dance of Fire and Ice</Game>
    <Game Condition="'$(Game)'=='' And Exists('C:\Program Files\Steam\steamapps\common\A Dance of Fire and Ice')">C:\Program Files\Steam\steamapps\common\A Dance of Fire and Ice</Game>

    <Managed Condition="'$(Managed)'=='' And Exists('$(Game)/ADanceOfFireAndIce.app/Contents/Resources/Data/Managed')">$(Game)/ADanceOfFireAndIce.app/Contents/Resources/Data/Managed</Managed>
    <Managed Condition="'$(Managed)'=='' And Exists('$(Game)/A Dance of Fire and Ice_Data/Managed')">$(Game)/A Dance of Fire and Ice_Data/Managed</Managed>

    <UMM Condition="'$(UMM)'=='' And Exists('$(Managed)/UnityModManager')">$(Managed)/UnityModManager</UMM>
    <UMM Condition="'$(UMM)'==''">$(Managed)</UMM>
    <UnityModManagerDll Condition="'$(UnityModManagerDll)'=='' And Exists('$(UMM)/UnityModManager.dll')">$(UMM)/UnityModManager.dll</UnityModManagerDll>
    <UnityModManagerDll Condition="'$(UnityModManagerDll)'=='' And Exists('$(Managed)/UnityModManager.dll')">$(Managed)/UnityModManager.dll</UnityModManagerDll>
    <UnityModManagerDll Condition="'$(UnityModManagerDll)'==''">$(UMM)/UnityModManager.dll</UnityModManagerDll>
    <HarmonyDll Condition="'$(HarmonyDll)'=='' And Exists('$(UMM)/0Harmony.dll')">$(UMM)/0Harmony.dll</HarmonyDll>
    <HarmonyDll Condition="'$(HarmonyDll)'=='' And Exists('$(Managed)/0Harmony.dll')">$(Managed)/0Harmony.dll</HarmonyDll>
    <HarmonyDll Condition="'$(HarmonyDll)'==''">$(UMM)/0Harmony.dll</HarmonyDll>

    <DistDir>$(MSBuildProjectDirectory)/dist</DistDir>
    <StageRoot>$(BuildRoot)/stage</StageRoot>
    <StageDir>$(StageRoot)/BypassedResourcePack</StageDir>
    <ZipPath>$(DistDir)/BypassedResourcePack.zip</ZipPath>
    <Dest Condition="'$(Dest)'==''">$(Game)/Mods/BypassedResourcePack</Dest>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(Managed)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RDTools"><HintPath>$(Managed)/RDTools.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(Managed)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(Managed)/UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(Managed)/UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(Managed)/UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextCoreFontEngineModule"><HintPath>$(Managed)/UnityEngine.TextCoreFontEngineModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextCoreTextEngineModule"><HintPath>$(Managed)/UnityEngine.TextCoreTextEngineModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(Managed)/UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(Managed)/UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(Managed)/Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(Managed)/Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityModManager"><HintPath>$(UnityModManagerDll)</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(HarmonyDll)</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="ValidatePaths" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(Game)')" Text="Could not locate ADOFAI. Set ADOFAI=/path/to/game or pass -p:Game=/path/to/game." />
    <Error Condition="!Exists('$(Managed)')" Text="Could not locate Managed directory. Pass -p:Managed=/path/to/Managed." />
    <Error Condition="!Exists('$(UnityModManagerDll)')" Text="UnityModManager.dll not found. Install Unity Mod Manager into ADOFAI or pass -p:UnityModManagerDll=/path/to/UnityModManager.dll." />
    <Error Condition="!Exists('$(HarmonyDll)')" Text="0Harmony.dll not found. Pass -p:HarmonyDll=/path/to/0Harmony.dll." />
    <Message Importance="high" Text="Game: $(Game)" />
    <Message Importance="high" Text="Managed: $(Managed)" />
  </Target>

  <Target Name="Package" AfterTargets="Build">
    <ItemGroup>
      <_Localization Include="$(MSBuildProjectDirectory)/localization/**/*.json" />
      <_Fonts Include="$(MSBuildProjectDirectory)/Fonts/**/*.otf;$(MSBuildProjectDirectory)/Fonts/**/*.ttf" />
    </ItemGroup>
    <RemoveDir Directories="$(StageRoot)" />
    <MakeDir Directories="$(DistDir);$(StageDir);$(StageDir)/localization;$(StageDir)/Fonts" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/meta/Info.json" DestinationFiles="$(StageDir)/Info.json" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(StageDir)" />
    <Copy SourceFiles="@(_Localization)" DestinationFiles="@(_Localization->'$(StageDir)/localization/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(_Fonts)" DestinationFiles="@(_Fonts->'$(StageDir)/Fonts/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Delete Files="$(ZipPath)" />
    <ZipDirectory SourceDirectory="$(StageRoot)" DestinationFile="$(ZipPath)" />
    <Message Importance="high" Text="Zip: $(ZipPath)" />
  </Target>

  <Target Name="Install" AfterTargets="Package" Condition="'$(Install)'=='true' Or '$(Deploy)'=='true'">
    <ItemGroup>
      <_Localization Include="$(MSBuildProjectDirectory)/localization/**/*.json" />
      <_Fonts Include="$(MSBuildProjectDirectory)/Fonts/**/*.otf;$(MSBuildProjectDirectory)/Fonts/**/*.ttf" />
    </ItemGroup>
    <Error Condition="!Exists('$(Game)')" Text="Install requested but Game path '$(Game)' not found." />
    <MakeDir Directories="$(Dest);$(Dest)/localization;$(Dest)/Fonts" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/meta/Info.json" DestinationFiles="$(Dest)/Info.json" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(Dest)" />
    <Copy SourceFiles="@(_Localization)" DestinationFiles="@(_Localization->'$(Dest)/localization/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(_Fonts)" DestinationFiles="@(_Fonts->'$(Dest)/Fonts/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Importance="high" Text="Installed to: $(Dest)" />
  </Target>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

</Project>
